# Server Port
PORT=5000

# CORS Configuration
CLIENT_URL=http://localhost:3000

# MongoDB URI (Set local or atlas link)
MONGO_URI=mongodb://localhost:27017/vedaai

# Redis Configuration (Optional, falls back to in-memory if empty/failed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider Keys
# Set at least one to enable live AI generation, otherwise system uses smart paper generator engine.
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
